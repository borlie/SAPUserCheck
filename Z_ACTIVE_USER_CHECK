*----------------------------------------------------------------------*
* CLASS lcl_alv_events DEFINITION
*----------------------------------------------------------------------*
CLASS lcl_alv_events DEFINITION.
  PUBLIC SECTION.
    METHODS:
      on_user_command FOR EVENT added_function OF cl_salv_events_table
        IMPORTING e_salv_function,
      on_link_click   FOR EVENT link_click OF cl_salv_events_table
        IMPORTING row column.
ENDCLASS.

*----------------------------------------------------------------------*
* GLOBAL DATA
*----------------------------------------------------------------------*
DATA:
  go_oauth_client TYPE REF TO if_oauth2_client,
  gt_results      TYPE tt_user_result,
  go_alv          TYPE REF TO cl_salv_table,
  go_events       TYPE REF TO lcl_alv_events,
  gv_bname        TYPE usr02-bname,
  gv_class        TYPE usr02-class.

*----------------------------------------------------------------------*
* CLASS lcl_alv_events IMPLEMENTATION
*----------------------------------------------------------------------*
CLASS lcl_alv_events IMPLEMENTATION.
  METHOD on_user_command.
    FIELD-SYMBOLS: <fs_row> TYPE ty_user_result.
    DATA(ls_stable) = VALUE lvc_s_stbl( row = abap_true col = abap_true ).

    CASE e_salv_function.
      WHEN 'PROCESS'.
        PERFORM process_selected_users.

      WHEN 'SEL_ACT'.
        LOOP AT gt_results ASSIGNING <fs_row>.
          IF <fs_row>-admin_proposal <> 'No Action' AND <fs_row>-admin_proposal <> 'Action Completed' AND NOT ( <fs_row>-admin_proposal CS 'Error' ).
            <fs_row>-mark = 'X'.
          ELSE.
            <fs_row>-mark = ' '.
          ENDIF.
        ENDLOOP.
        go_alv->refresh( s_stable = ls_stable refresh_mode = if_salv_c_refresh=>full ).

      WHEN 'DSEL_ALL'.
        LOOP AT gt_results ASSIGNING <fs_row>.
          <fs_row>-mark = ' '.
        ENDLOOP.
        go_alv->refresh( s_stable = ls_stable refresh_mode = if_salv_c_refresh=>full ).

      WHEN 'SET_LOCK'.
        LOOP AT gt_results ASSIGNING <fs_row> WHERE mark = 'X'.
          <fs_row>-admin_proposal = 'Lock User'.
          <fs_row>-mark = ' '.
        ENDLOOP.
        go_alv->refresh( s_stable = ls_stable refresh_mode = if_salv_c_refresh=>full ).

      WHEN 'SET_TERM'.
        LOOP AT gt_results ASSIGNING <fs_row> WHERE mark = 'X'.
          <fs_row>-admin_proposal = 'Terminate User'.
          <fs_row>-mark = ' '.
        ENDLOOP.
        go_alv->refresh( s_stable = ls_stable refresh_mode = if_salv_c_refresh=>full ).

      WHEN 'SET_UPDT'.
        LOOP AT gt_results ASSIGNING <fs_row> WHERE mark = 'X'.
          <fs_row>-admin_proposal = 'Update Address Data'.
          <fs_row>-mark = ' '.
        ENDLOOP.
        go_alv->refresh( s_stable = ls_stable refresh_mode = if_salv_c_refresh=>full ).

      WHEN 'SET_NONE'.
        LOOP AT gt_results ASSIGNING <fs_row> WHERE mark = 'X'.
          <fs_row>-admin_proposal = 'No Action'.
          <fs_row>-mark = ' '.
        ENDLOOP.
        go_alv->refresh( s_stable = ls_stable refresh_mode = if_salv_c_refresh=>full ).
    ENDCASE.
  ENDMETHOD.

  METHOD on_link_click.
    FIELD-SYMBOLS: <fs_row> TYPE ty_user_result.
    DATA(ls_stable) = VALUE lvc_s_stbl( row = abap_true col = abap_true ).

    IF column = 'MARK'.
      READ TABLE gt_results ASSIGNING <fs_row> INDEX row.
      IF sy-subrc = 0.
        <fs_row>-mark = COND #( WHEN <fs_row>-mark = 'X' THEN ' ' ELSE 'X' ).
        go_alv->refresh( s_stable = ls_stable refresh_mode = if_salv_c_refresh=>full ).
      ENDIF.
    ENDIF.
  ENDMETHOD.
ENDCLASS.

*----------------------------------------------------------------------*
* SELECTION SCREEN
*----------------------------------------------------------------------*
" --- 1. Mode Selector ---
SELECTION-SCREEN BEGIN OF BLOCK b_mode WITH FRAME TITLE TEXT-m01.
  PARAMETERS: p_r_cln RADIOBUTTON GROUP mod USER-COMMAND switch DEFAULT 'X', " Clean Up Tool
              p_r_upd RADIOBUTTON GROUP mod,                                 " Data Update Tool
              p_r_cfg RADIOBUTTON GROUP mod.                                 " API Settings
SELECTION-SCREEN END OF BLOCK b_mode.

" --- 2. Shared User Selection ---
SELECTION-SCREEN BEGIN OF BLOCK b_user WITH FRAME TITLE TEXT-b01.
  SELECT-OPTIONS: so_bname FOR gv_bname DEFAULT '*' OPTION CP SIGN I MODIF ID run.
  SELECT-OPTIONS: so_class FOR gv_class MODIF ID run.
SELECTION-SCREEN END OF BLOCK b_user.

" --- 3. Clean Up Specific Parameters ---
SELECTION-SCREEN BEGIN OF BLOCK b_cln WITH FRAME TITLE TEXT-b04.
  PARAMETERS: p_locked AS CHECKBOX DEFAULT ' ' MODIF ID cln,
              p_nolog  AS CHECKBOX DEFAULT ' ' MODIF ID cln,
              p_days   TYPE i DEFAULT 100 MODIF ID cln.
SELECTION-SCREEN END OF BLOCK b_cln.

" --- 4. Update Specific Parameters ---
SELECTION-SCREEN BEGIN OF BLOCK b_updt WITH FRAME TITLE TEXT-b05.
  PARAMETERS: p_upd_f AS CHECKBOX DEFAULT 'X' MODIF ID upd, " Update First Name
              p_upd_l AS CHECKBOX DEFAULT 'X' MODIF ID upd, " Update Last Name
              p_upd_i AS CHECKBOX DEFAULT 'X' MODIF ID upd, " Update Initials
              p_upd_t AS CHECKBOX DEFAULT 'X' MODIF ID upd, " Update Job Title
              p_upd_d AS CHECKBOX DEFAULT 'X' MODIF ID upd, " Update Department
              p_upd_p AS CHECKBOX DEFAULT 'X' MODIF ID upd, " Update Phone
              p_upd_m AS CHECKBOX DEFAULT 'X' MODIF ID upd. " Update Email
SELECTION-SCREEN END OF BLOCK b_updt.

" --- 5. API Configuration Parameters ---
SELECTION-SCREEN BEGIN OF BLOCK b_azure WITH FRAME TITLE TEXT-b02.
  PARAMETERS:
    p_dstgrp TYPE rfcdest DEFAULT 'ENTRA_GRAPH_API' MODIF ID cfg.
SELECTION-SCREEN END OF BLOCK b_azure.

*----------------------------------------------------------------------*
* SELECTION SCREEN EVENTS
*----------------------------------------------------------------------*
AT SELECTION-SCREEN OUTPUT.
  LOOP AT SCREEN.
    IF p_r_cln = 'X' AND ( screen-group1 = 'UPD' OR screen-group1 = 'CFG' ).
      screen-active = 0.
    ELSEIF p_r_upd = 'X' AND ( screen-group1 = 'CLN' OR screen-group1 = 'CFG' ).
      screen-active = 0.
    ELSEIF p_r_cfg = 'X' AND ( screen-group1 = 'RUN' OR screen-group1 = 'CLN' OR screen-group1 = 'UPD' ).
      screen-active = 0.
    ENDIF.
    MODIFY SCREEN.
  ENDLOOP.

*----------------------------------------------------------------------*
* START-OF-SELECTION
*----------------------------------------------------------------------*
START-OF-SELECTION.

  IF p_r_cfg = 'X'.
    MESSAGE 'Settings screen is for saving variants. Select a tool mode to process users.' TYPE 'S' DISPLAY LIKE 'W'.
    RETURN.
  ENDIF.

  PERFORM fetch_sap_users.
  PERFORM get_graph_token.
  PERFORM enrich_graph_data.
  PERFORM evaluate_proposals.
  PERFORM display_alv.

*----------------------------------------------------------------------*
* FORM: FETCH_SAP_USERS
*----------------------------------------------------------------------*
FORM fetch_sap_users.
  SELECT bname, ustyp, class, gltgv, gltgb, trdat, uflag
    FROM usr02
    INTO TABLE @DATA(lt_usr02)
    WHERE bname IN @so_bname
      AND class IN @so_class
      AND ustyp = 'A'.

  LOOP AT lt_usr02 INTO DATA(ls_usr02).
    IF p_r_cln = 'X'.
      IF p_locked = ' ' AND ls_usr02-uflag <> 0.         CONTINUE. ENDIF.
      IF p_nolog  = ' ' AND ls_usr02-trdat = '00000000'. CONTINUE. ENDIF.
    ELSEIF p_r_upd = 'X'.
      IF ls_usr02-uflag <> 0. CONTINUE. ENDIF.
    ENDIF.

    APPEND VALUE ty_user_result(
      bname         = ls_usr02-bname
      ustyp         = ls_usr02-ustyp
      class         = ls_usr02-class
      uflag         = ls_usr02-uflag
      gltgv         = ls_usr02-gltgv
      gltgb         = ls_usr02-gltgb
      trdat         = ls_usr02-trdat
      lookup_status = 'Pending'
    ) TO gt_results.
  ENDLOOP.

  IF gt_results IS INITIAL.
    MESSAGE 'No dialog users found matching selection criteria.' TYPE 'S' DISPLAY LIKE 'W'.
    LEAVE LIST-PROCESSING.
  ENDIF.
ENDFORM.

*----------------------------------------------------------------------*
* FORM: GET_GRAPH_TOKEN
*----------------------------------------------------------------------*
FORM get_graph_token.
  DATA: lx_oauth TYPE REF TO cx_oa2c.

  TRY.
      cl_oauth2_client=>create(
        EXPORTING
          i_profile        = 'Z_ENTRAGRAPH'
        RECEIVING
          ro_oauth2_client = go_oauth_client ).

    CATCH cx_oa2c INTO lx_oauth.
      MESSAGE lx_oauth->get_text( ) TYPE 'E'.
      LEAVE LIST-PROCESSING.
  ENDTRY.
ENDFORM.

*----------------------------------------------------------------------*
* FORM: ENRICH_GRAPH_DATA
*----------------------------------------------------------------------*
FORM enrich_graph_data.
  DATA: ls_batch_req     TYPE ty_batch_request,
        ls_batch_payload TYPE ty_batch_payload,
        lv_json_response TYPE string,
        ls_batch_result  TYPE ty_batch_result.

  DATA(lv_total) = lines( gt_results ).
  DATA(lv_select) = 'displayName,userPrincipalName,accountEnabled,givenName,surname,mobilePhone,mail,jobTitle,department'.

  LOOP AT gt_results ASSIGNING FIELD-SYMBOL(<fs_res>).
    DATA(lv_idx) = sy-tabix.
    DATA(lv_pct) = ( lv_idx * 100 ) / lv_total.

    CALL FUNCTION 'SAPGUI_PROGRESS_INDICATOR'
      EXPORTING
        percentage = lv_pct
        text       = |Checking Entra ID: { lv_idx } / { lv_total } ({ <fs_res>-bname })|.

    DATA(lv_upn) = to_lower( |{ <fs_res>-bname }@aurobay.com| ).

    CLEAR ls_batch_req.
    ls_batch_req-id     = |U_{ <fs_res>-bname }|.
    ls_batch_req-method = 'GET'.
    ls_batch_req-url    = |/users/{ lv_upn }?$select={ lv_select }|.
    APPEND ls_batch_req TO ls_batch_payload-requests.

    IF lines( ls_batch_payload-requests ) >= 18 OR lv_idx = lv_total.
      DATA(lv_json_payload) = /ui2/cl_json=>serialize(
        data        = ls_batch_payload
        pretty_name = /ui2/cl_json=>pretty_mode-camel_case ).

      PERFORM call_graph_batch USING lv_json_payload CHANGING lv_json_response.

      IF lv_json_response IS NOT INITIAL.
        CLEAR ls_batch_result.
        /ui2/cl_json=>deserialize( EXPORTING json = lv_json_response CHANGING data = ls_batch_result ).

        LOOP AT ls_batch_result-responses INTO DATA(ls_batch_resp).
          DATA(lv_type)  = ls_batch_resp-id(2).
          DATA(lv_bname) = CONV usr02-bname( ls_batch_resp-id+2 ).

          READ TABLE gt_results ASSIGNING FIELD-SYMBOL(<fs_update>) WITH KEY bname = lv_bname.
          IF sy-subrc = 0 AND lv_type = 'U_' AND ls_batch_resp-status = 200.
            <fs_update>-az_display_name = ls_batch_resp-body-displayName.
            <fs_update>-az_upn          = ls_batch_resp-body-userPrincipalName.
            <fs_update>-az_mail         = ls_batch_resp-body-mail.
            <fs_update>-az_job_title    = ls_batch_resp-body-jobTitle.
            <fs_update>-az_department   = ls_batch_resp-body-department.
            <fs_update>-az_given_name   = ls_batch_resp-body-givenName.
            <fs_update>-az_surname      = ls_batch_resp-body-surname.
            <fs_update>-az_phone        = ls_batch_resp-body-mobilePhone.

            IF <fs_update>-az_given_name IS NOT INITIAL AND <fs_update>-az_surname IS NOT INITIAL.
              <fs_update>-az_initials = to_upper( |{ <fs_update>-az_given_name(1) }{ <fs_update>-az_surname(1) }| ).
            ENDIF.

            <fs_update>-az_enabled = COND #( WHEN ls_batch_resp-body-accountEnabled = abap_true THEN 'True' ELSE 'False' ).
            <fs_update>-lookup_status = 'Found in Azure AD'.
          ELSEIF sy-subrc = 0.
            <fs_update>-lookup_status = 'Not found in Azure AD'.
          ENDIF.
        ENDLOOP.
      ENDIF.
      CLEAR ls_batch_payload-requests.
    ENDIF.
  ENDLOOP.
ENDFORM.

*----------------------------------------------------------------------*
* FORM: CALL_GRAPH_BATCH
*----------------------------------------------------------------------*
FORM call_graph_batch USING pv_body TYPE string CHANGING pv_response TYPE string.
  DATA: lo_http   TYPE REF TO if_http_client,
        lv_status TYPE i,
        lx_oauth  TYPE REF TO cx_oa2c.

  CLEAR pv_response.

  cl_http_client=>create_by_destination(
    EXPORTING  destination = p_dstgrp
    IMPORTING  client      = lo_http
    EXCEPTIONS OTHERS      = 1 ).

  IF sy-subrc <> 0. RETURN. ENDIF.

  lo_http->request->set_method( if_http_request=>co_request_method_post ).
  lo_http->request->set_header_field( name = '~request_uri' value = '/v1.0/$batch' ).
  lo_http->request->set_header_field( name = 'Accept'       value = 'application/json' ).
  lo_http->request->set_header_field( name = 'Content-Type' value = 'application/json' ).
  lo_http->request->set_cdata( data = pv_body ).

  IF go_oauth_client IS BOUND.
    TRY.
        go_oauth_client->set_token( io_http_client = lo_http ).
      CATCH cx_oa2c_at_not_available cx_oa2c_at_expired.
        TRY.
            go_oauth_client->execute_cc_flow( ).
            go_oauth_client->set_token( io_http_client = lo_http ).
          CATCH cx_oa2c INTO lx_oauth.
            lo_http->close( ). RETURN.
        ENDTRY.
      CATCH cx_oa2c INTO lx_oauth.
        lo_http->close( ). RETURN.
    ENDTRY.
  ENDIF.

  lo_http->send( EXCEPTIONS OTHERS = 1 ).
  IF sy-subrc <> 0. lo_http->close( ). RETURN. ENDIF.

  lo_http->receive( EXCEPTIONS OTHERS = 1 ).
  IF sy-subrc <> 0. lo_http->close( ). RETURN. ENDIF.

  lo_http->response->get_status( IMPORTING code = lv_status ).
  IF lv_status = 200.
    pv_response = lo_http->response->get_cdata( ).
  ENDIF.

  lo_http->close( ).
ENDFORM.

*----------------------------------------------------------------------*
* FORM: EVALUATE_PROPOSALS
*----------------------------------------------------------------------*
FORM evaluate_proposals.
  DATA(lv_date_limit) = sy-datum - p_days.

  LOOP AT gt_results ASSIGNING FIELD-SYMBOL(<fs_user>).
    IF <fs_user>-trdat IS NOT INITIAL AND <fs_user>-trdat <> '00000000'.
      <fs_user>-days_since_logon = sy-datum - <fs_user>-trdat.
    ENDIF.

    IF p_r_cln = 'X'.
      IF <fs_user>-class = 'TERMINATED' AND <fs_user>-uflag <> 0.
        <fs_user>-admin_proposal = 'No Action'.
        <fs_user>-lookup_status  = 'Already Terminated in SAP'.
        CONTINUE.
      ENDIF.

      IF <fs_user>-az_enabled = 'False' OR <fs_user>-lookup_status = 'Not found in Azure AD'.
        <fs_user>-admin_proposal = 'Terminate User'.
      ELSEIF <fs_user>-trdat < lv_date_limit AND <fs_user>-trdat IS NOT INITIAL AND <fs_user>-trdat <> '00000000'.
        <fs_user>-admin_proposal = 'Lock User'.
      ELSE.
        <fs_user>-admin_proposal = 'No Action'.
      ENDIF.

    ELSEIF p_r_upd = 'X'.
      IF <fs_user>-az_enabled = 'True' OR <fs_user>-lookup_status = 'Found in Azure AD'.
        <fs_user>-admin_proposal = 'Update Address Data'.
      ELSE.
        <fs_user>-admin_proposal = 'No Action'.
      ENDIF.
    ENDIF.
  ENDLOOP.
ENDFORM.

*----------------------------------------------------------------------*
* FORM: DISPLAY_ALV
*----------------------------------------------------------------------*
FORM display_alv.
  DATA: lo_cols  TYPE REF TO cl_salv_columns_table,
        lx_msg   TYPE REF TO cx_salv_msg.

  TRY.
      cl_salv_table=>factory(
        IMPORTING r_salv_table = go_alv
        CHANGING  t_table      = gt_results ).
    CATCH cx_salv_msg INTO lx_msg.
      MESSAGE lx_msg->get_text( ) TYPE 'E'.
      RETURN.
  ENDTRY.

  " Uncomment this when the GUI Status is created in SE41
  go_alv->set_screen_status(
    pfstatus      = 'PROCESSUSER'
    report        = sy-repid
    set_functions = go_alv->c_functions_all ).

  lo_cols = go_alv->get_columns( ).
  lo_cols->set_optimize( abap_true ).

  TRY. lo_cols->get_column( 'USTYP' )->set_visible( abap_false ). CATCH cx_salv_not_found. ENDTRY.
  TRY. lo_cols->get_column( 'UFLAG' )->set_visible( abap_false ). CATCH cx_salv_not_found. ENDTRY.

  TRY.
      DATA(lo_class_col) = CAST cl_salv_column_table( lo_cols->get_column( 'CLASS' ) ).
      lo_class_col->set_short_text( 'Usr Group' ).
      lo_class_col->set_medium_text( 'User Group' ).
      lo_class_col->set_long_text( 'Logon User Group' ).
    CATCH cx_salv_not_found.
  ENDTRY.

  TRY.
      DATA(lo_col) = CAST cl_salv_column_table( lo_cols->get_column( 'MARK' ) ).
      lo_col->set_cell_type( if_salv_c_cell_type=>checkbox_hotspot ).
      lo_col->set_short_text( 'Select' ).
    CATCH cx_salv_not_found.
  ENDTRY.

  TRY.
      DATA(lo_prop_col) = CAST cl_salv_column_table( lo_cols->get_column( 'ADMIN_PROPOSAL' ) ).
      lo_prop_col->set_short_text( 'Action' ).
      lo_prop_col->set_medium_text( 'Proposal' ).
      lo_prop_col->set_long_text( 'Admin Proposal' ).
    CATCH cx_salv_not_found.
  ENDTRY.

  TRY.
      DATA(lo_days_col) = CAST cl_salv_column_table( lo_cols->get_column( 'DAYS_SINCE_LOGON' ) ).
      lo_days_col->set_short_text( 'Days Inact' ).
      lo_days_col->set_medium_text( 'Days Inactive' ).
      lo_days_col->set_long_text( 'Days Since Last Logon' ).
    CATCH cx_salv_not_found.
  ENDTRY.

  TRY.
      DATA(lo_lookup_col) = CAST cl_salv_column_table( lo_cols->get_column( 'LOOKUP_STATUS' ) ).
      lo_lookup_col->set_short_text( 'Status' ).
      lo_lookup_col->set_medium_text( 'API Status' ).
      lo_lookup_col->set_long_text( 'Graph API Lookup Status' ).
    CATCH cx_salv_not_found.
  ENDTRY.

  TRY. CAST cl_salv_column_table( lo_cols->get_column( 'AZ_DISPLAY_NAME' ) )->set_short_text( 'Entra Name' ). CATCH cx_salv_not_found. ENDTRY.
  TRY. CAST cl_salv_column_table( lo_cols->get_column( 'AZ_UPN' ) )->set_short_text( 'UPN' ). CATCH cx_salv_not_found. ENDTRY.
  TRY. CAST cl_salv_column_table( lo_cols->get_column( 'AZ_MAIL' ) )->set_short_text( 'Email' ). CATCH cx_salv_not_found. ENDTRY.
  TRY. CAST cl_salv_column_table( lo_cols->get_column( 'AZ_ENABLED' ) )->set_short_text( 'Active' ). CATCH cx_salv_not_found. ENDTRY.
  TRY. CAST cl_salv_column_table( lo_cols->get_column( 'AZ_JOB_TITLE' ) )->set_short_text( 'Job Title' ). CATCH cx_salv_not_found. ENDTRY.
  TRY. CAST cl_salv_column_table( lo_cols->get_column( 'AZ_DEPARTMENT' ) )->set_short_text( 'Dept.' ). CATCH cx_salv_not_found. ENDTRY.

  DATA(lo_events) = go_alv->get_event( ).
  CREATE OBJECT go_events.
  SET HANDLER go_events->on_user_command FOR lo_events.
  SET HANDLER go_events->on_link_click   FOR lo_events.

  go_alv->display( ).
ENDFORM.

*----------------------------------------------------------------------*
* FORM: PROCESS_SELECTED_USERS
*----------------------------------------------------------------------*
FORM process_selected_users.
  DATA: ls_logondata  TYPE bapilogond,
        ls_logondatax TYPE bapilogonx,
        ls_address    TYPE bapiaddr3,
        ls_addressx   TYPE bapiaddr3x,
        lt_return     TYPE STANDARD TABLE OF bapiret2,
        lt_roles      TYPE STANDARD TABLE OF bapiagr.

  LOOP AT gt_results ASSIGNING FIELD-SYMBOL(<fs_user>) WHERE mark = 'X'.
    CLEAR: ls_logondata, ls_logondatax, ls_address, ls_addressx, lt_return, lt_roles.

    IF <fs_user>-admin_proposal = 'Terminate User'.
      CALL FUNCTION 'BAPI_USER_LOCK'
        EXPORTING username = <fs_user>-bname
        TABLES    return   = lt_return.

      ls_logondata-class  = 'TERMINATED'.
      ls_logondatax-class = 'X'.
      ls_logondata-gltgv  = '00000000'.
      ls_logondatax-gltgv = 'X'.
      ls_logondata-gltgb  = sy-datum.
      ls_logondatax-gltgb = 'X'.

      CALL FUNCTION 'BAPI_USER_CHANGE'
        EXPORTING username   = <fs_user>-bname
                  logondata  = ls_logondata
                  logondatax = ls_logondatax
        TABLES    return     = lt_return.

      CALL FUNCTION 'BAPI_USER_ACTGROUPS_ASSIGN'
        EXPORTING username       = <fs_user>-bname
        TABLES    activitygroups = lt_roles
                  return         = lt_return.

    ELSEIF <fs_user>-admin_proposal = 'Lock User'.
      CALL FUNCTION 'BAPI_USER_LOCK'
        EXPORTING username = <fs_user>-bname
        TABLES    return   = lt_return.

      ls_logondata-class  = 'INACT'.
      ls_logondatax-class = 'X'.
      ls_logondata-gltgv  = '00000000'.
      ls_logondatax-gltgv = 'X'.

      IF <fs_user>-trdat IS NOT INITIAL AND <fs_user>-trdat <> '00000000'.
        ls_logondata-gltgb  = <fs_user>-trdat.
        ls_logondatax-gltgb = 'X'.
      ENDIF.

      CALL FUNCTION 'BAPI_USER_CHANGE'
        EXPORTING username   = <fs_user>-bname
                  logondata  = ls_logondata
                  logondatax = ls_logondatax
        TABLES    return     = lt_return.

    ELSEIF <fs_user>-admin_proposal = 'Update Address Data'.
      IF p_upd_t = 'X' AND <fs_user>-az_job_title IS NOT INITIAL.
        ls_address-function  = <fs_user>-az_job_title.
        ls_addressx-function = 'X'.
      ENDIF.
      IF p_upd_d = 'X' AND <fs_user>-az_department IS NOT INITIAL.
        ls_address-department  = <fs_user>-az_department.
        ls_addressx-department = 'X'.
      ENDIF.
      IF p_upd_m = 'X' AND <fs_user>-az_mail IS NOT INITIAL.
        ls_address-e_mail  = <fs_user>-az_mail.
        ls_addressx-e_mail = 'X'.
      ENDIF.
      IF p_upd_f = 'X' AND <fs_user>-az_given_name IS NOT INITIAL.
        ls_address-firstname  = <fs_user>-az_given_name.
        ls_addressx-firstname = 'X'.
      ENDIF.
      IF p_upd_l = 'X' AND <fs_user>-az_surname IS NOT INITIAL.
        ls_address-lastname  = <fs_user>-az_surname.
        ls_addressx-lastname = 'X'.
      ENDIF.
      IF p_upd_i = 'X' AND <fs_user>-az_initials IS NOT INITIAL.
        ls_address-initials  = <fs_user>-az_initials.
        ls_addressx-initials = 'X'.
      ENDIF.
      IF p_upd_p = 'X' AND <fs_user>-az_phone IS NOT INITIAL.
        ls_address-tel1_numbr  = <fs_user>-az_phone.
        ls_addressx-tel1_numbr = 'X'.
      ENDIF.

      CALL FUNCTION 'BAPI_USER_CHANGE'
        EXPORTING username = <fs_user>-bname
                  address  = ls_address
                  addressx = ls_addressx
        TABLES    return   = lt_return.
    ENDIF.

    " Error Handling Check
    READ TABLE lt_return WITH KEY type = 'E' TRANSPORTING NO FIELDS.
    IF sy-subrc = 0.
      <fs_user>-admin_proposal = 'Error Occurred'.
    ELSE.
      " Update ALV view based on action
      IF <fs_user>-admin_proposal = 'Terminate User'.
        <fs_user>-class = 'TERMINATED'.
        <fs_user>-gltgv = '00000000'.
        <fs_user>-gltgb = sy-datum.
        <fs_user>-lookup_status = 'Terminated via ALV'.
      ELSEIF <fs_user>-admin_proposal = 'Lock User'.
        <fs_user>-class = 'INACT'.
        <fs_user>-gltgv = '00000000'.
        IF <fs_user>-trdat IS NOT INITIAL AND <fs_user>-trdat <> '00000000'.
          <fs_user>-gltgb = <fs_user>-trdat.
        ENDIF.
        <fs_user>-lookup_status = 'Deactivated via ALV'.
      ELSEIF <fs_user>-admin_proposal = 'Update Address Data'.
        <fs_user>-lookup_status = 'Updated via ALV'.
      ENDIF.

      <fs_user>-admin_proposal = 'Action Completed'.
    ENDIF.

    <fs_user>-mark = ' '.
  ENDLOOP.

  CALL FUNCTION 'BAPI_TRANSACTION_COMMIT' EXPORTING wait = 'X'.
  MESSAGE 'Selected users have been processed.' TYPE 'S'.

  go_alv->refresh( s_stable = VALUE lvc_s_stbl( row = abap_true col = abap_true ) refresh_mode = if_salv_c_refresh=>full ).
ENDFORM.